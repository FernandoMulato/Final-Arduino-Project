@startuml Classes
' ====================================================================
' Class diagram - Access Control and Security System
' Arquitectura Computacional - Arduino Mega (ATmega2560)
' 6-state FSM with StateMachineLib, AsyncTaskLib, EEPROM profiles
' Based on v4_main.ino — unified hardware build
' ====================================================================

skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam backgroundColor white

' === DATA STRUCTURES ===
package "Data" as dataPkg #F0F0F0 {
  struct User #FFFACD;line:Black {
    {field} pin[5]: char
    {field} role: uint8_t
    {field} uses: uint8_t
    {field} active: bool
    {field} histIdx: uint8_t
    {field} history[4][4]: char
  }
  note right of User
    role: 1=Security, 2=Operator
    3=Coordinator, 4=Manager
    uses: max 10 before PIN rotation
    history: last 4 PINs (circular)
    PIN policy: 4-6 digits
    EEPROM = 10 users x 24 bytes
  end note
}

' === STATE MACHINE ===
package "State Machine" as fsmPkg #F0F0F0 {
  enum State #B3D9FF;line:Black {
    S_IDLE
    S_OPEN
    S_BLOCKED
    S_INTRUSION_MONITOR
    S_ENV_MONITOR
    S_ALARM
  }

  enum Trigger #B3D9FF;line:Black {
    TRIG_NONE
    TRIG_AUTH_OK
    TRIG_TIMER_DONE
    TRIG_LOCKOUT
    TRIG_ENV_ALARM
    TRIG_INTRUSION
  }

  class StateMachine #E8E8E8;line:Black {
    {method} +SetOnEntering(state, callback): void
    {method} +SetOnLeaving(state, callback): void
    {method} +AddTransition(from, to, guard): void
    {method} +SetState(state, bool, bool): void
    {method} +Update(): void
  }
  note right of StateMachine
    StateMachineLib v1.0.0
    6 states, 11 transitions
    5 transitions use TRIG_TIMER_DONE (millis)
    6 use event triggers (auth, lockout, alarm, intrusion)
  end note
}

' === PERIPHERALS ===
package "Peripherals" as perifPkg #F0F0F0 {
  class Keypad #D4E6F1;line:Black {
    {method} +getKey(): char
  }
  note right of Keypad
    Keypad 3.1.1 library
    4x4 matrix on D29,D31,D33,D35
    / D37,D39,D41,D43
    Map: 1-3A, 4-6B, 7-9C, *0#D
    SRAM arrays (not PROGMEM)
  end note

  class EEPROM #D4E6F1;line:Black {
    {method} +read(addr): uint8_t
    {method} +write(addr, val): void
    {method} +update(addr, val): void
  }
  note left of EEPROM
    4KB on ATmega2560
    Layout:
    0x00: Magic 0xA5
    0x01: User count
    0x02+: Users (10 x 24 bytes)
    User record:
      PIN[4] + role + uses + active
      + histIdx + history[16]
    Seed users (first boot):
      1234 (Manager), 5678 (Operator)
      9999 (Security)
  end note

  class MFRC522 #D4E6F1;line:Black {
    {method} +PICC_IsNewCardPresent(): bool
    {method} +PICC_ReadCardSerial(): bool
    {method} +PICC_HaltA(): void
    {method} +PCD_Init(): void
  }
  note right of MFRC522
    RFID reader
    SS=53, RST=49
    2 authorized cards:
      Card 1 → ROLE_MANAGER
      Card 2 → ROLE_OPERATOR
    Polled from IDLE via checkRFID()
  end note

  class LiquidCrystal #D4E6F1;line:Black {
    {method} +begin(cols, rows): void
    {method} +print(text): void
    {method} +setCursor(col, row): void
    {method} +clear(): void
  }
  note right of LiquidCrystal
    LCD 16x2 parallel 4-bit
    RS=12, EN=11, D4=5, D5=4
    D6=3, D7=2
    Messages: IDLE, ACCESS GRANTED,
    BLOCKED, MONITOR ENV, MONITOR SEC
    PIN entry: **** #=ok
  end note

  class AsyncTask #D4E6F1;line:Black {
    {field} Interval: unsigned long
    {field} AutoReset: bool
    {method} +Start(): void
    {method} +Stop(): void
    {method} +Update(): bool
  }
  note right of AsyncTask
    AsyncTaskLib 1.0.0
    sensorTask: 200ms interval
    Reads NTC (A1), LDR (A2), MIC (A0)
    Non-blocking sensor averaging
  end note
}

' === SENSORS ===
package "Sensors" as sensPkg #F0F0F0 {
  class SensorNTC #D5F5E3;line:Black {
    {method} +read(): float
  }
  note right of SensorNTC
    Pin A1 — KY-013
    Steinhart-Hart equation
    Averaged via RunningAverage (5)
    Threshold: <20°C or >50°C
    Clamp: sane to 25°C on error
  end note

  class SensorLDR #D5F5E3;line:Black {
    {method} +read(): int
  }
  note right of SensorLDR
    Pin A2 — KY-018
    Averaged via RunningAverage (5)
    Inverted: higher ADC = more light
    Threshold: <100 (dark) → IDLE via timer
  end note

  class SensorHall #D5F5E3;line:Black {
    {field} doorChanged: volatile bool
    {method} +doorISR(): void
  }
  note right of SensorHall
    Pin D21 (INT2) — reed switch
    attachInterrupt(CHANGE)
    INPUT_PULLUP: closed=LOW, open=HIGH
    ISR sets doorChanged flag (minimal)
    Loop reads doorChanged + digitalRead()
    Edge detection for ALARM counting
  end note

  class Microphone #D5F5E3;line:Black {
    {method} +read(): int
  }
  note right of Microphone
    Pin A0 — KY-037
    Polled at 200ms by AsyncTask
    Threshold: ADC > 800
  end note

  class RunningAverage #D5F5E3;line:Black {
    {method} +add(value): void
    {method} +getAverage(): float
    {method} +getCount(): uint8_t
  }
  note right of RunningAverage
    RunningAverage 0.4.9
    5-sample sliding window
    Used by NTC + LDR
  end note
}

' === ACTUATORS ===
package "Actuators" as actPkg #F0F0F0 {
  class Servo #FADBD8;line:Black {
    {method} +attach(pin): void
    {method} +write(angle): void
  }
  note right of Servo
    Pin D13 (PWM)
    Locked: 0° (SRV_LOCKED)
    Unlocked: 90° (SRV_UNLOCKED)
    Duration: 2s (T_UNLOCK)
  end note

  class RGB_LED #FADBD8;line:Black {
    {method} +setRGB(r, g, b): void
    {method} +ledOff(): void
    {method} +ledRed(): void
    {method} +ledGreen(): void
    {method} +ledBlue(): void
    {method} +updateBlinkPattern(): void
  }
  note right of RGB_LED
    R=A3, G=A4, B=A5 (analog→digital)
    GREEN on ACCESS GRANTED (S_OPEN)
    BLUE on MONITOR modes
    RED blink on BLOCKED (300/700ms)
    RED fast blink on ALARM (100/500ms)
  end note

  class Buzzer #FADBD8;line:Black {
    {method} +on(): void
    {method} +off(): void
  }
  note right of Buzzer
    Pin D9 — Piezo
    tone() — non-blocking square wave
    1kHz continuous during ALARM
    Synchronized with LED blink in BLOCKED
    (tone/noTone toggles with LED)
  end note
}

' === CONTROLLER ===
package "Controller" as sysPkg #F0F0F0 {
  class System #FFCCCC;line:Black {
    {field} currentState: State
    {field} trigger: Trigger
    {field} pinBuf[7]: char
    {field} pinLen: uint8_t
    {field} failCount: uint8_t
    {field} temperature: float
    {field} lightLevel: int
    {field} micVal: int
    {field} alarmCount: uint8_t
    {field} firstAlarmTime: unsigned long
    {field} lastAuthRole: uint8_t
    {field} lastAuthUserIdx: uint8_t
    {field} pinChangeRequired: bool
    {field} pinChangeUserIdx: uint8_t
    {field} menuActive: bool
    {field} menuStep: uint8_t
    {field} menuBuf[7]: char
    {field} menuUserIdx: uint8_t
    {field} menuConfirmTime: unsigned long
    {field} menuConfirmPending: bool
    {field} buzzerTimedOff: bool
    {field} buzzerOffTime: unsigned long
    {field} lastPageSwitch: unsigned long
    {field} displayPage: bool
    ..
    {method} +setupFSM(): void
    {method} +processInput(): void
    {method} +updateState(): void
    {method} +updateDisplay(): void
    {method} +updateBlinkPattern(): void
    {method} +validateAccess(pin): bool
    {method} +findUserByPin(pin): uint8_t
    {method} +pinIsUnique(idx, pin): bool
    {method} +rotatePin(idx, newPin): void
    {method} +addUser(pin, role): void
    {method} +setUserCount(c): void
    {method} +initEEPROM(): void
    {method} +handlePinEntry(key): void
    {method} +handleMenuKey(key): void
    {method} +closeMenu(): void
    {method} +checkRFID(): uint8_t
  }
  note bottom of System
    Single-file: src/main.ino (v4)
    1688 lines, 0 external modules
    StateMachineLib for FSM (real build)
    AsyncTaskLib for sensor timing (200ms)
    millis() for state timing + blink
    tone() for buzzer (non-blocking)
    F() macro for all PROGMEM strings
    Key features:
    · 6-state FSM, 11 transitions
    · PIN auth with history rotation
    · Menu: PIN change (old→new→confirm)
    · Triple alarm detection (3 in 12s)
    · Debug keys A/B from IDLE
    · PIN timeout after 10s idle
    · PIN expiration after 10 uses
    · Hall sensor ISR on D21 (INT2)
    · RFID card auth (MFRC522)
  end note
}

' === RELATIONSHIPS ===
System --> State : "uses"
System --> Trigger : "fires"
System --> StateMachine : "controls"
System --> Keypad : "reads keys"
System --> EEPROM : "persists data"
System --> MFRC522 : "reads cards"
System --> LiquidCrystal : "displays status"
System --> AsyncTask : "schedules sensor reads"
System --> SensorNTC : "reads temp (A1)"
System --> SensorLDR : "reads light (A2)"
System --> SensorHall : "reads door (D21 INT2)"
System --> Microphone : "reads sound (A0)"
System --> RunningAverage : "smooths NTC+LDR"
System --> Servo : "actuates lock (D13)"
System --> RGB_LED : "status indicator (A3-A5)"
System --> Buzzer : "sound alarm (D9)"
System --> User : "manages"

SensorNTC --> RunningAverage : "uses"
SensorLDR --> RunningAverage : "uses"

@enduml

@startuml Classes
' ====================================================================
' Class diagram - Access Control and Security System
' Arquitectura Computacional - Arduino Mega (ATmega2560)
' 6-state FSM with AsyncTaskLib, Servo, LiquidCrystal, RunningAverage
' ====================================================================

skinparam classAttributeIconSize 0
skinparam defaultFontName SansSerif
skinparam backgroundColor white

' === DATA STRUCTURES ===
package "Data" as dataPkg #F0F0F0 {
  struct User #FFFACD;line:Black {
    {field} pin[5]: char
    {field} role: uint8_t
    {field} uses: uint8_t
    {field} active: bool
    {field} histIdx: uint8_t
    {field} history[4][4]: char
  }
  note right of User
    role: 1=Security, 2=Operator
    3=Coordinator, 4=Manager
    uses: max 4 before PIN rotation
    history: last 4 PINs (circular)
  end note
}

' === STATE MACHINE ===
package "State Machine" as fsmPkg #F0F0F0 {
  enum State #B3D9FF;line:Black {
    S_IDLE
    S_OPEN
    S_BLOCKED
    S_INTRUSION_MONITOR
    S_ENV_MONITOR
    S_ALARM
  }

  enum Trigger #B3D9FF;line:Black {
    TRIG_AUTH_OK
    TRIG_LOCKOUT
    TRIG_ENV_ALARM
    TRIG_INTRUSION
  }

  class StateMachine #E8E8E8;line:Black {
    {method} +SetOnEntering(state, callback): void
    {method} +SetOnLeaving(state, callback): void
    {method} +AddTransition(from, to, guard): void
    {method} +SetState(state, bool, bool): void
    {method} +Update(): void
  }
  note right of StateMachine
    StateMachineLib v1.0.0
    6 states, 10 transitions
  end note
}

' === PERIPHERALS ===
package "Peripherals" as perifPkg #F0F0F0 {
  class Keypad #D4E6F1;line:Black {
    {method} +getKey(): char
  }
  note right of Keypad
    Keypad 3.1.1 library
    4x4 matrix on D2-D9
    Map: 1-3A, 4-6B, 7-9C, *0#D
  end note

  class EEPROM #D4E6F1;line:Black {
    {method} +read(addr): uint8_t
    {method} +write(addr, val): void
    {method} +update(addr, val): void
  }
  note left of EEPROM
    4KB on ATmega2560
    Layout:
    0: Magic 0xA5
    1: User count
    2+: Users (10 x 24 bytes)
    Each user: PIN[4]+role+uses
    +active+histIdx+history[16]
  end note

  class LiquidCrystal #D4E6F1;line:Black {
    {method} +begin(cols, rows): void
    {method} +print(text): void
    {method} +setCursor(col, row): void
    {method} +clear(): void
  }
  note right of LiquidCrystal
    LCD Keypad Shield (16x2)
    Parallel 4-bit mode
    RS=D22, EN=D23, D4-D7=D24-D27
    Status codes: IDLE, OPEN
    ERR, ALR, BLK
  end note

  class AsyncTask #D4E6F1;line:Black {
    {field} Interval: unsigned long
    {field} AutoReset: bool
    {field} OnFinish: callback
    {method} +Start(): void
    {method} +Stop(): void
    {method} +Reset(): void
    {method} +Update(): bool
  }
  note right of AsyncTask
    AsyncTaskLib 1.0.0
    Sensor averaging: 200ms
    Periodic sensor reads
    Non-blocking timing
  end note
}

' === SENSORS ===
package "Sensors" as sensPkg #F0F0F0 {
  class SensorNTC #D5F5E3;line:Black {
    {field} runningAvg: RunningAverage
    {method} +read(): float
  }
  note right of SensorNTC
    Pin A1
    Steinhart-Hart equation
    Averaged via RunningAverage
    Threshold: <20 C or >50 C
  end note

  class SensorLDR #D5F5E3;line:Black {
    {field} runningAvg: RunningAverage
    {method} +read(): int
  }
  note right of SensorLDR
    Pin A2
    Averaged via RunningAverage
    Threshold: ADC < 100
  end note

  class SensorHall #D5F5E3;line:Black {
    {method} +read(): int
  }
  note right of SensorHall
    Pin A3 - door magnetic sensor
    Threshold: ADC > 512
  end note

  class Microphone #D5F5E3;line:Black {
    {method} +read(): int
  }
  note right of Microphone
    Pin A0 - KY-037
    Threshold: ADC > 800
  end note
}

' === ACTUATORS ===
package "Actuators" as actPkg #F0F0F0 {
  class Servo #FADBD8;line:Black {
    {method} +attach(pin): void
    {method} +write(angle): void
  }
  note right of Servo
    Pin D12 (PWM)
    Locked: 0 degrees
    Unlocked: 90 degrees
    Duration: 2s (T_UNLOCK)
  end note

  class RedLED #FADBD8;line:Black {
    {method} +on(): void
    {method} +off(): void
  }
  note right of RedLED
    Pin D10
    BLOCK: 300/700ms
    ALARM: 100/500ms
  end note

  class Buzzer #FADBD8;line:Black {
    {method} +on(): void
    {method} +off(): void
  }
  note right of Buzzer: Pin D11 - Piezo, ON in ALARM
}

' === CONTROLLER ===
package "Controller" as sysPkg #F0F0F0 {
  class System #FFCCCC;line:Black {
    {field} currentState: State
    {field} trigger: Trigger
    {field} pinBuf[7]: char
    {field} failCount: uint8_t
    {field} temperature: float
    {field} lightLevel: int
    {field} alarmCount: uint8_t
    ..
    {method} +setupFSM(): void
    {method} +processInput(): void
    {method} +updateState(): void
    {method} +updateDisplay(): void
    {method} +validateAccess(pin): bool
    {method} +findUserByPin(pin): uint8_t
    {method} +rotatePin(idx, newPin): void
    {method} +initEEPROM(): void
  }
  note bottom of System
    Single-file: src/main.ino
    ~560 lines, 0 external modules
    F() macro for PROGMEM
    AsyncTaskLib for sensor timing
    millis() for state timing + blink
  end note
}

' === RELATIONSHIPS ===
System --> State : "uses"
System --> Trigger : "fires"
System --> StateMachine : "controls"
System --> Keypad : "reads keys"
System --> EEPROM : "persists data"
System --> LiquidCrystal : "displays status"
System --> AsyncTask : "schedules reads"
System --> SensorNTC : "reads temp"
System --> SensorLDR : "reads light"
System --> SensorHall : "reads door"
System --> Microphone : "reads sound"
System --> Servo : "actuates lock"
System --> RedLED : "alarm signal"
System --> Buzzer : "sound alarm"
System --> User : "manages"
System --> RunningAverage : "smooths sensors"

SensorNTC --> RunningAverage : "uses"
SensorLDR --> RunningAverage : "uses"

@enduml

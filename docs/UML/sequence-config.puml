@startuml UserConfig
' ====================================================================
' Sequence diagram - PIN change via menu (within IDLE state)
' From IDLE, press # with no digits -> menu -> change PIN -> save
' ====================================================================

skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center

actor "User" as USR #FFFACD
participant "Keypad\n4x4" as KPD #D4E6F1
participant "System\n(loop)" as SYS #FFCCCC
participant "EEPROM" as EEP #D4E6F1
participant "LCD\n16x2" as LCD #D4E6F1

== IDLE - entering menu mode ==
note right: State S_IDLE\nLCD: "IDLE", "Enter PIN:"

USR -> KPD: Presses '#' (no digits entered)
KPD -> SYS: getKey() = '#'
SYS -> SYS: pinLen == 0 -> menu mode
SYS -> SYS: menuActive = true, menuStep = 0
LCD -> SYS: "CHANGE PIN"\n"Old PIN:****"

== Menu Step 0: Enter old PIN ==
USR -> KPD: Presses '1','2','3','4'
KPD -> SYS: getKey() = digits
SYS -> SYS: menuBuf = "1234", menuBufLen = 4

USR -> KPD: Presses '#' (confirm old PIN)
KPD -> SYS: getKey() = '#'
SYS -> EEP: findUserByPin("1234")
EEP --> SYS: userIdx = 2
SYS -> SYS: menuUserIdx = 2, menuStep = 1
LCD -> SYS: "CHANGE PIN"\n"New PIN:----"

== Menu Step 1: Enter new PIN ==
USR -> KPD: Presses '5','6','7','8'
KPD -> SYS: getKey() = digits
SYS -> SYS: menuBuf = "5678", menuBufLen = 4

USR -> KPD: Presses '#' (confirm new PIN)
KPD -> SYS: getKey() = '#'
SYS -> SYS: pinIsUnique(2, "5678") = true
note right: Checked against current\nPIN + 4 history entries
SYS -> EEP: rotatePin(2, "5678")
note right: saveUser(userIdx, newPin,\nrole, uses=0, histIdx+1,\noldPin pushed to history[histIdx])
SYS -> SYS: menuActive = false
LCD -> SYS: "PIN changed"\n"Enter PIN:"
SYS -> Serial: "[MENU] PIN changed successfully!"
note right: pinChangeRequired flag\ncleared if was set

== Alternative: Cancel ==
USR -> KPD: Presses '*'
KPD -> SYS: getKey() = '*'
SYS -> SYS: menuActive = false, menuStep = 0
LCD -> SYS: "IDLE"\n"Enter PIN:"
note right: Any time during menu\n'*' cancels and returns\nto idle IDLE

@enduml

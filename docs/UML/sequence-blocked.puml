@startuml BlockedAttempts
' ====================================================================
' Sequence diagram - Block after 3 failed attempts (v4_main.ino)
' PIN incorrect x3 -> BLOCKED 5s (LED 300/700ms + buzzer beep) -> IDLE
' ====================================================================

skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center

actor "User" as USR #FFFACD
participant "Keypad 4x4\nD29,D31,D33,D35" as KPD #D4E6F1
participant "System\n(loop)" as SYS #FFCCCC
participant "EEPROM" as EEP #D4E6F1
participant "StateMachine" as FSM #B3D9FF
participant "RGB LED\nR=A3" as RGB #FADBD8
participant "Buzzer\nD9" as BUZ #FADBD8
participant "LCD 16x2\nRS=12 EN=11" as LCD #D4E6F1

== IDLE - failed attempts ==

loop 3 failed attempts
  USR -> KPD: Enters wrong PIN + '#'
  KPD -> SYS: getKey() = digits + #
  SYS -> SYS: handlePinEntry('#')\nvalidateAccess(pin)
  SYS -> EEP: findUserByPin()
  EEP --> SYS: PIN not found
  SYS -> SYS: failCount++
  note right: failCount = #{x}\npinBuf cleared\nuser can retry
end

USR -> KPD: Enters 3rd wrong PIN + '#'
KPD -> SYS: getKey() = digits + #
SYS -> SYS: failCount >= 3
SYS -> FSM: trig = TRIG_LOCKOUT
FSM -> SYS: Transition to S_BLOCKED
SYS -> SYS: onEnterBlocked()
SYS -> BUZ: tone(1000) — 1kHz
note right: 200ms beep\n(delay(200))
SYS -> BUZ: noTone()
SYS -> RGB: blink RED active (300/700ms)
note right: Green+Blue turned OFF\nRed channel blinks\nStarts ON for immediate feedback
SYS -> LCD: "BLOCKED"\n"Wait 5s..."

== BLOCKED - LED blink 5 seconds ==
note right: T_LOCKOUT = 5000ms
loop ~6 cycles of 300ms ON / 700ms OFF
  SYS -> RGB: ON (300ms)
  SYS -> RGB: OFF (700ms)
end

FSM -> SYS: trig = TRIG_AUTH_OK (5s expired)
SYS -> RGB: ledOff()
FSM -> SYS: Transition to S_IDLE
SYS -> SYS: onEnterIdle()
note right: failCount = 0\npinBuf cleared\nSystem restored

@enduml

@startuml IntrusionAlarm
' ====================================================================
' Sequence diagram - Intrusion and alarm (interrupt-driven)
' Reed switch on D21 -> ISR -> ALARM (2s, 100/500ms blink)
' -> INTRUSION_MONITOR -> IDLE
' alarmCount increments per alarm entry (v2 behavior)
' ====================================================================

skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center

participant "Reed Switch\nD21 (INT2)" as REED #D5F5E3
participant "Microphone\nA0" as MIC #D5F5E3
participant "doorISR()" as ISR #D5F5E3
participant "System\n(loop)" as SYS #FFCCCC
participant "AsyncTask\nsensorTask" as ASYNC #D4E6F1
participant "StateMachine" as FSM #B3D9FF
participant "RGB LED\nR22" as RGB #FADBD8
participant "Buzzer\nD9" as BUZ #FADBD8
participant "LCD\n16x2" as LCD #D4E6F1

== INTRUSION MONITOR - waiting ==
note right: State S_INTRUSION_MONITOR\nLED: blue\nLCD: "MONITOR SEC"\n"Door: CLOSED"

REED -> ISR: **Door opens**\nPin goes HIGH (pullup)
note right: attachInterrupt(CHANGE)\nImmediate — no polling!
ISR -> ISR: doorChanged = true
ISR -> REED: return

SYS -> SYS: updateState()\ndoorChanged == true
SYS -> SYS: hallDoorOpen = true
note right: Edge consumed for\nINTRUSION_MONITOR
SYS -> SYS: trig = TRIG_INTRUSION

FSM -> SYS: Transition to S_ALARM
SYS -> SYS: onEnterAlarm()
SYS -> RGB: blink RED fast (100/500ms)
note right: Green+Blue turned OFF
SYS -> BUZ: tone(1000) — 1kHz
SYS -> SYS: alarmCount++
SYS -> LCD: "!!! ALARM !!!"\n"Event #1"

== ALARM - countdown ==
note right: T_ALARM = 2000ms

loop timer not expired
  SYS -> SYS: updateBlinkPattern()\n100ms ON / 500ms OFF
  note right: Buzzer always ON\nduring ALARM
end

FSM -> SYS: trig = TRIG_AUTH_OK (2s)
SYS -> SYS: onLeaveAlarm()
SYS -> BUZ: noTone()
SYS -> RGB: ledOff()

FSM -> SYS: Transition to S_INTRUSION_MONITOR
SYS -> RGB: ledBlue()
note right: alarmCount = 1\nready for next event

== Second entry: re-alarm ==
note right: Later: another intrusion\nalarmCount++ in onEnterAlarm()

@enduml

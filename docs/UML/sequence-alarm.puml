@startuml IntrusionAlarm
' ====================================================================
' Sequence diagram - Intrusion and alarm (interrupt-driven)
' Reed switch on D21 -> ISR triggers -> ALARM (2s, 100/500ms)
' -> INTRUSION_MONITOR -> IDLE
' ====================================================================

skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center

participant "Reed Switch\nD21 (INT2)" as REED #D5F5E3
participant "Microphone\nA0" as MIC #D5F5E3
participant "doorISR()" as ISR #D5F5E3
participant "System\n(loop)" as SYS #FFCCCC
participant "AsyncTask\nsensorTask" as ASYNC #D4E6F1
participant "StateMachine" as FSM #B3D9FF
participant "Red LED\nD10" as LED #FADBD8
participant "Buzzer\nD11" as BUZ #FADBD8

== INTRUSION MONITOR - waiting ==
note right: State S_INTRUSION_MONITOR\nLCD: "MONITOR SEC"

REED -> ISR: **Door opens**\nPin goes HIGH (pullup)
note right: attachInterrupt(CHANGE)\nImmediate — no polling!
ISR -> ISR: doorChanged = true
ISR -> REED: return

SYS -> SYS: updateState()\ndoorChanged == true
SYS -> SYS: hallDoorOpen = true
SYS -> SYS: doorChanged = false
note right #FFCCCC: Edge consumed here\nso ALARM won't\ndouble-count
SYS -> SYS: trig = TRIG_INTRUSION

FSM -> SYS: Update()
FSM -> SYS: Transition to S_ALARM
SYS -> SYS: onEnterAlarm()
SYS -> BUZ: HIGH
SYS -> LED: blink active (100/500ms)
note right: Alarm activated\nDuration: 2 seconds

== ALARM - blink + buzzer ==
loop until timer expires
  SYS -> SYS: Blink: LED 100ms ON / 500ms OFF
  note right: Buzzer always ON\nduring ALARM
end

== Additional events during ALARM ==
MIC -> ASYNC: sensorTask tick (200ms)
ASYNC -> SYS: micVal > 800 (loud sound)
SYS -> SYS: alarmCount = 1

REED -> ISR: **Door closes then opens again**\nCHANGE x2
ISR -> ISR: doorChanged = true
SYS -> SYS: updateState()\ndoorChanged == true\nhallDoorOpen = true
SYS -> SYS: alarmCount = 2
note right: Edge-triggered: only\ncounts physical OPEN\nevents, not steady state

MIC -> ASYNC: sensorTask tick
ASYNC -> SYS: micVal > 800
SYS -> SYS: alarmCount = 3
note right: 3 events in <12s = TRIPLE!\nAlarm timer reset

FSM -> SYS: trig = TRIG_AUTH_OK (2s expired)
FSM -> SYS: Transition to S_INTRUSION_MONITOR
SYS -> SYS: onLeaveAlarm()
SYS -> BUZ: LOW
SYS -> LED: off

== INTRUSION MONITOR - 2s watch ==
MIC -> ASYNC: sensorTask ticks\nmicVal = 350 (quiet)
REED -> ISR: **Door closes** (CHANGE)
ISR -> ISR: doorChanged = true
SYS -> SYS: hallDoorOpen = false
note right: Door closed.\nNo trigger since\nhallDoorOpen is false

SYS -> SYS: No intrusion - timer expires
FSM -> SYS: trig = TRIG_AUTH_OK (2s)
FSM -> SYS: Transition to S_IDLE
SYS -> SYS: onEnterIdle()
note right: System restored

@enduml

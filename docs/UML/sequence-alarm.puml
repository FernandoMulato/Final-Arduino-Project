@startuml IntrusionAlarm
' ====================================================================
' Sequence diagram - Intrusion and alarm
' Hall sensor -> ALARM (2s, 100/500ms) -> MONITOR_INTRUSOS -> IDLE
' ====================================================================

skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center

participant "Hall Sensor\nA3" as HALL #D5F5E3
participant "Microphone\nA0" as MIC #D5F5E3
participant "System\n(loop)" as SYS #FFCCCC
participant "AsyncTask\nsensorTask" as ASYNC #D4E6F1
participant "StateMachine" as FSM #B3D9FF
participant "Red LED\nD10" as LED #FADBD8
participant "Buzzer\nD11" as BUZ #FADBD8

== INTRUSION MONITOR - waiting ==
note right: State S_MONITOR_INTRUSOS\nLCD: "MONITOR SEC"

loop each sensorTask tick (200ms)
  ASYNC -> HALL: analogRead(PIN_HALL)
  ASYNC -> MIC: analogRead(PIN_MIC)
  HALL --> SYS: hallVal = 612
  note right: Threshold > 512\nDoor opened!
  SYS -> SYS: trig = TRIG_INTRUSION
end

FSM -> SYS: Update()
FSM -> SYS: Transition to S_ALARM
SYS -> SYS: onEnterAlarm()
SYS -> BUZ: HIGH
SYS -> LED: blink active (100/500ms)
note right: Alarm activated\nDuration: 2 seconds

== ALARM - blink + buzzer ==
loop until timer expires
  SYS -> SYS: Blink: LED 100ms ON / 500ms OFF
  note right: Buzzer always ON\nduring ALARM
end

MIC -> SYS: micVal > 800 (sonic event)
SYS -> SYS: alarmCount = 1
HALL -> SYS: hallVal > 512 (door open)
SYS -> SYS: alarmCount = 2
MIC -> SYS: micVal > 800
SYS -> SYS: alarmCount = 3
note right: 3 events in <12s = TRIPLE!\nAlarm timer reset

FSM -> SYS: trig = TRIG_AUTH_OK (2s expired)
FSM -> SYS: Transition to S_INTRUSION_MONITOR
SYS -> SYS: onLeaveAlarm()
SYS -> BUZ: LOW
SYS -> LED: off

== INTRUSION MONITOR - 2s watch ==
HALL --> SYS: hallVal = 420 (door closed)
MIC --> SYS: micVal = 350 (no sound)
SYS -> SYS: No intrusion - timer expires

FSM -> SYS: trig = TRIG_AUTH_OK (2s)
FSM -> SYS: Transition to S_IDLE
SYS -> SYS: onEnterIdle()
note right: System restored

@enduml

@startuml IntrusionAlarm
' ====================================================================
' Sequence diagram - Intrusion and alarm (v4_main.ino)
' Reed switch on D21 (INT2) -> ISR -> ALARM (2s, 100/500ms blink)
' -> INTRUSION_MONITOR -> IDLE
' Triple alarm detection: 3 events in 12s (T_TRIPLE) extends alarm
' ====================================================================

skinparam backgroundColor white
skinparam defaultFontName SansSerif
skinparam sequenceMessageAlign center

participant "Reed Switch\nD21 (INT2)" as REED #D5F5E3
participant "Microphone\nA0" as MIC #D5F5E3
participant "doorISR()" as ISR #D5F5E3
participant "System\n(loop)" as SYS #FFCCCC
participant "AsyncTask\nsensorTask\n(200ms)" as ASYNC #D4E6F1
participant "StateMachine" as FSM #B3D9FF
participant "RGB LED\nR=A3" as RGB #FADBD8
participant "Buzzer\nD9" as BUZ #FADBD8

== INTRUSION MONITOR - watching ==
note right: State S_INTRUSION_MONITOR\nLED: blue\nLCD: "MONITOR SEC" / "Door: CLOSED"\nalarmCount=0

REED -> ISR: **Door opens**\nPin goes HIGH (INPUT_PULLUP)
note right: attachInterrupt(CHANGE)\nImmediate — no polling!
ISR -> ISR: doorChanged = true
ISR -> REED: return

SYS -> SYS: updateState()\ndoorChanged == true
SYS -> SYS: hallDoorOpen = true
note right: Detección por nivel:\nINTRUSION_MONITOR\n(ALARM usa flanco via doorChanged)
SYS -> SYS: trig = TRIG_INTRUSION

FSM -> SYS: Transition to S_ALARM
SYS -> SYS: onEnterAlarm()
SYS -> RGB: blink RED fast (100/500ms)
note right: Green+Blue turned OFF
SYS -> BUZ: tone(1000) — 1kHz continuous
SYS -> SYS: alarmCount++ (now = 1)
SYS -> SYS: if alarmCount==1 → firstAlarmTime = now
note right: LCD NO se actualiza en ALARM\n(updateDisplay() no tiene case S_ALARM)

== ALARM - countdown ==
note right: T_ALARM = 2000ms

loop timer not expired
  SYS -> SYS: updateBlinkPattern()\n100ms ON / 500ms OFF
  note right: Buzzer always ON\nduring ALARM
end

FSM -> SYS: trig = TRIG_TIMER_DONE (2s)
SYS -> SYS: onLeaveAlarm()
SYS -> BUZ: noTone()
SYS -> RGB: ledOff()

FSM -> SYS: Transition to S_INTRUSION_MONITOR
SYS -> RGB: ledBlue()
note right: alarmCount = 1\nready for next event

== Second intrusion: triple alarm test ==
note right: Later: door opens again\nwithin T_TRIPLE (12s)

REED -> ISR: **Door opens again**
ISR -> ISR: doorChanged = true
SYS -> SYS: updateState() -> trig = TRIG_INTRUSION
FSM -> SYS: Transition to S_ALARM
SYS -> SYS: onEnterAlarm()\nalarmCount++ (now = 2)
note right: alarmCount < 3\nnormal alarm cycle

FSM -> SYS: trig = TRIG_TIMER_DONE (2s)
FSM -> SYS: Transition to S_INTRUSION_MONITOR

== Third intrusion: triple alarm fires ==
note right: 3rd event still within\nT_TRIPLE (12s from firstAlarmTime)

REED -> ISR: **Door opens again (3rd time)**
SYS -> SYS: onEnterAlarm()\nalarmCount++ (now = 3)
SYS -> SYS: alarmCount >= 3 AND\n(now - firstAlarmTime) < T_TRIPLE?
note right: TRIPLE ALARM!\nalarmCount=0\nstateEntryTime=now\n(extends alarm duration)\nBuzzer stays ON\nLED continues fast blink

@enduml
